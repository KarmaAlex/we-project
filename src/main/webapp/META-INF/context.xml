<?xml version="1.0" encoding="UTF-8"?>
<Context path="/BaseWebAppT10">
    <Resource name="jdbc/soccorso"
              auth="Container"
              type="javax.sql.DataSource"
              driverClassName="com.mysql.cj.jdbc.Driver"
              url="jdbc:mysql://localhost:3306/soccorso?serverTimezone=UTC"
              username="soccorso_app"
              password="soccorsoapp"
              maxTotal="100" 
              maxIdle="30" 
              maxWaitMillis="10000"/>
    <Parameter
        name="data.source"
        value="jdbc/soccorso"
        override="false"
    />
</Context>