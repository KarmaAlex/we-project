<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <servlet>
        <servlet-name>Servlet1</servlet-name>
        <servlet-class>org.soccorsoweb.test.AServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Servlet1</servlet-name>
        <url-pattern>/aservletpath</url-pattern>
        <!-- we can add more than a path for a servlet, even with (ending) wildcards -->
        <!-- possiamo aggiungere più di un path per una servlet, anche con wildcard finali -->
        <url-pattern>/another/servletpath</url-pattern>
        <url-pattern>/all/these/*</url-pattern>
    </servlet-mapping>
    
    
    <!-- diagnostic servlet for development only -->
    <servlet>
        <servlet-name>Diagnostic</servlet-name>
        <servlet-class>org.soccorsoweb.test.DiagnosticServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>Diagnostic</servlet-name>
        <url-pattern>/diagnostic</url-pattern>
    </servlet-mapping>
    
    
    <!-- Admin Dashboard -->
    <servlet>
        <servlet-name>AdminDashboard</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.AdminDashboardServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>AdminDashboard</servlet-name>
        <url-pattern>/admin-dashboard</url-pattern>
    </servlet-mapping>
    
    
    <!-- Operator Dashboard -->
    <servlet>
        <servlet-name>OperatorDashboard</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.OperatorDashboardServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>OperatorDashboard</servlet-name>
        <url-pattern>/operator-dashboard</url-pattern>
    </servlet-mapping>
    
    
    <!-- Detail API Servlet (for modal content) -->
    <servlet>
        <servlet-name>DetailApi</servlet-name>
        <servlet-class>org.soccorsoweb.test.DetailApiServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>DetailApi</servlet-name>
        <url-pattern>/api/detail/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MaterialDetailsController</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.admin.details.MaterialDetailsController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>MaterialDetailsController</servlet-name>
        <url-pattern>/api/detail/materials/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EditApi</servlet-name>
        <servlet-class>org.soccorsoweb.test.EditApiServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>EditApi</servlet-name>
        <url-pattern>/api/edit/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AddApi</servlet-name>
        <servlet-class>org.soccorsoweb.test.AddApiServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>AddApi</servlet-name>
        <url-pattern>/api/add/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CreaRichiesta</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.CreaRichiestaServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>CreaRichiesta</servlet-name>
        <url-pattern>/submit</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.HomeServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/</url-pattern>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.LoginServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SignupServlet</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.SignupServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>SignupServlet</servlet-name>
        <url-pattern>/signup</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.ProfileServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/profile</url-pattern>
        <url-pattern>/operator/profile</url-pattern>
    </servlet-mapping>
    
    
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
    <!-- here we can specify (if we need to!) the default path for the context -->
    <!-- qui possiamo specificare (se necessario!) il path di default del contesto -->
    <welcome-file-list>
        <welcome-file>/home</welcome-file>
    </welcome-file-list>
</web-app>
