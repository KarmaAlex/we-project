<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <servlet>
        <servlet-name>Servlet1</servlet-name>
        <servlet-class>org.soccorsoweb.test.AServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Servlet1</servlet-name>
        <url-pattern>/aservletpath</url-pattern>
        <!-- we can add more than a path for a servlet, even with (ending) wildcards -->
        <!-- possiamo aggiungere più di un path per una servlet, anche con wildcard finali -->
        <url-pattern>/another/servletpath</url-pattern>
        <url-pattern>/all/these/*</url-pattern>
    </servlet-mapping>
    
    
    <!-- diagnostic servlet for development only -->
    <servlet>
        <servlet-name>Diagnostic</servlet-name>
        <servlet-class>org.soccorsoweb.test.DiagnosticServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>Diagnostic</servlet-name>
        <url-pattern>/diagnostic</url-pattern>
    </servlet-mapping>
    
    
    <!-- Admin Dashboard -->
    <servlet>
        <servlet-name>AdminDashboardController</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.admin.AdminDashboardController</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>AdminDashboardController</servlet-name>
        <url-pattern>/admin-dashboard</url-pattern>
    </servlet-mapping>
    
    
    <!-- Operator Dashboard -->
    <servlet>
        <servlet-name>OperatorDashboardController</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.OperatorDashboardController</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>OperatorDashboardController</servlet-name>
        <url-pattern>/operator-dashboard</url-pattern>
    </servlet-mapping>
    
    
    <!-- Detail API Servlets (for modal content) -->
    <servlet>
        <servlet-name>MaterialDetailsController</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.admin.details.MaterialDetailsController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>MaterialDetailsController</servlet-name>
        <url-pattern>/api/detail/materials/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>OperatorDetailsController</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.admin.details.OperatorDetailsController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>OperatorDetailsController</servlet-name>
        <url-pattern>/api/detail/operators/*</url-pattern>
        <url-pattern>/api/detail/operatori/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RequestDetailsController</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.admin.details.RequestDetailsController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>RequestDetailsController</servlet-name>
        <url-pattern>/api/detail/requests/*</url-pattern>
        <url-pattern>/api/detail/richieste/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MissionDetailsController</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.admin.details.MissionDetailsController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>MissionDetailsController</servlet-name>
        <url-pattern>/api/detail/missions/*</url-pattern>
        <url-pattern>/api/detail/missioni/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>VehicleDetailsController</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.admin.details.VehicleDetailsController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>VehicleDetailsController</servlet-name>
        <url-pattern>/api/detail/vehicles/*</url-pattern>
        <url-pattern>/api/detail/mezzi/*</url-pattern>
    </servlet-mapping>

    <!-- Edit API Servlet -->    
    <servlet>
        <servlet-name>EditApi</servlet-name>
        <servlet-class>org.soccorsoweb.test.EditApiServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>EditApi</servlet-name>
        <url-pattern>/api/edit/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EditVehicleController</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.admin.edit.EditVehicleController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>EditVehicleController</servlet-name>
        <url-pattern>/api/edit/mezzi/*</url-pattern>
        <url-pattern>/api/edit/vehicles/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EditOperatorController</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.admin.edit.EditOperatorController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>EditOperatorController</servlet-name>
        <url-pattern>/api/edit/operatori/*</url-pattern>
        <url-pattern>/api/edit/operators/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EditMissionController</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.admin.edit.EditMissionController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>EditMissionController</servlet-name>
        <url-pattern>/api/edit/missioni/*</url-pattern>
        <url-pattern>/api/edit/missions/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EditRequestController</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.admin.edit.EditRequestController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>EditRequestController</servlet-name>
        <url-pattern>/api/edit/richieste/*</url-pattern>
        <url-pattern>/api/edit/requests/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EditMaterialController</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.admin.edit.EditMateralController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>EditMaterialController</servlet-name>
        <url-pattern>/api/edit/materiali/*</url-pattern>
        <url-pattern>/api/edit/materials/*</url-pattern>
    </servlet-mapping>

    <!-- Delete -->
    <servlet>
        <servlet-name>DeleteMaterialController</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.admin.delete.DeleteMaterialController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>DeleteMaterialController</servlet-name>
        <url-pattern>/api/delete/materiali/*</url-pattern>
        <url-pattern>/api/delete/materials/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DeleteVehicleController</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.admin.delete.DeleteVehicleController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>DeleteVehicleController</servlet-name>
        <url-pattern>/api/delete/mezzi/*</url-pattern>
        <url-pattern>/api/delete/vehicles/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AddApi</servlet-name>
        <servlet-class>org.soccorsoweb.test.AddApiServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>AddApi</servlet-name>
        <url-pattern>/api/add/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AddMissionController</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.admin.add.AddMissionController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>AddMissionController</servlet-name>
        <url-pattern>/api/add/missioni/*</url-pattern>
        <url-pattern>/api/add/missions/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AddMaterialController</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.admin.add.AddMaterialController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>AddMaterialController</servlet-name>
        <url-pattern>/api/add/materials/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AddVehicleController</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.admin.add.AddVehicleController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>AddVehicleController</servlet-name>
        <url-pattern>/api/add/vehicles/*</url-pattern>
        <url-pattern>/api/add/mezzi/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AddOperatorController</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.admin.add.AddOperatorController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>AddOperatorController</servlet-name>
        <url-pattern>/api/add/operators/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CreaRichiestaController</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.CreaRichiestaController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>CreaRichiestaController</servlet-name>
        <url-pattern>/submit</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>VerifyRequestController</servlet-name>
        <servlet-class>org.soccorsoweb.business.VerifyRequestController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>VerifyRequestController</servlet-name>
        <url-pattern>/verify-request</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>HomeController</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.HomeController</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>HomeController</servlet-name>
        <url-pattern>/</url-pattern>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LoginController</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.LoginController</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>LoginController</servlet-name>
        <url-pattern>/login</url-pattern>
        <url-pattern>/Login</url-pattern>
    </servlet-mapping>

   <servlet>
        <servlet-name>LogoutController</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.LogoutController</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>LogoutController</servlet-name>
        <url-pattern>/logout</url-pattern>
        <url-pattern>/Logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SignupController</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.SignupController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>SignupController</servlet-name>
        <url-pattern>/signup</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProfileController</servlet-name>
        <servlet-class>org.soccorsoweb.business.controller.ProfileController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ProfileController</servlet-name>
        <url-pattern>/profile</url-pattern>
        <url-pattern>/operator/profile</url-pattern>
    </servlet-mapping>
    
    
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
    <!-- here we can specify (if we need to!) the default path for the context -->
    <!-- qui possiamo specificare (se necessario!) il path di default del contesto -->
    <welcome-file-list>
        <welcome-file>/home</welcome-file>
    </welcome-file-list>
</web-app>
